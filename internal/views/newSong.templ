package views

import "mshocrylas.com/music-league/internal/validator"

type SongForm struct {
	Title, Artist, URL string
	validator.Validator
}

templ NewSong(form SongForm) {
	@Base("Add a song") {
		<h1>Add a song</h1>
		<form action="/songs" method="post">
			<label>
				Title:
				@textInput("text", "title", form.Title, form.FieldErrors, true)
			</label>
			<label>
				Artist:
				@textInput("text", "artist", form.Artist, form.FieldErrors, true)
			</label>
			<label>
				Link:
				@textInput("url", "url", form.URL, form.FieldErrors, false)
			</label>
			<button type="submit">Create Song</button>
		</form>
	}
}

templ textInput(inputType, name, value string, fieldErrors map[string]string, required bool) {
	{{ msg, hasErr := fieldErrors[name] }}
	<input
		type={ inputType }
		name={ name }
		value={ value }
		required?={ required }
		if hasErr {
			aria-invalid="true"
		}
	/>
	if hasErr {
		<small>{ msg }</small>
	}
}
