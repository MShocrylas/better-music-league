package views

import "mshocrylas.com/music-league/internal/db"

type LeaguePage struct {
	League db.League
	Rounds []db.Round
	Form   RoundForm
}

templ League(p LeaguePage) {
	@Base(p.League.Name) {
		<h1>{ p.League.Name }</h1>
		<h2>Rounds</h2>
		@RoundList(p.Rounds)
		<h3>Add a new round:</h3>
		@NewRound(p.League.LeagueID, p.Form)
	}
}
