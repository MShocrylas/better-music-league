package views

import "mshocrylas.com/music-league/internal/validator"
import "time"
import "fmt"

type RoundForm struct {
	Theme              string
	Position           int64
	SubmissionDeadline time.Time
	VotingDeadline     time.Time
	validator.Validator
}

templ NewRound(leagueID int64, form RoundForm) {
	<form action={ fmt.Sprintf("/leagues/%d/rounds", leagueID) } method="post">
		<div>
			<label for="theme">Theme: </label>
			<input type="text" name="theme" id="theme" value={ form.Theme } required/>
			if msg, ok := form.FieldErrors["theme"]; ok {
				<p>{ msg }</p>
			}
		</div>
		<button type="submit">Add Round</button>
	</form>
}
